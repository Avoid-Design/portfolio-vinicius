---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/urls';
---

<BaseLayout
  title="Página não encontrada | Vinicius Rafael"
  description="A página solicitada não foi encontrada."
  canonicalPath="404/"
  robots="noindex,follow"
>
  <main id="conteudo-principal" class="not-found" tabindex="-1">
    <p class="eyebrow">Erro / 404</p>
    <h1>Este arquivo não foi encontrado.</h1>
    <p>O endereço pode ter mudado ou o projeto ainda não está disponível.</p>
    <a class="button-link" href={withBase()}>Voltar ao portfólio</a>
  </main>
</BaseLayout>
