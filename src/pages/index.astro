---
import AboutExperience from '../components/AboutExperience.astro';
import Opening from '../components/Opening.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import { PUBLIC_SITE_URL, site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedProjects } from '../utils/projects';

const projects = await getPublishedProjects();

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: PUBLIC_SITE_URL,
  jobTitle: site.role,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bauru',
    addressRegion: 'SP',
    addressCountry: 'BR',
  },
};
---

<BaseLayout canonicalPath="" jsonLd={personJsonLd}>
  <main id="conteudo-principal" tabindex="-1">
    <Opening />
    <AboutExperience />
    <ProjectsSection projects={projects} />
  </main>
</BaseLayout>
