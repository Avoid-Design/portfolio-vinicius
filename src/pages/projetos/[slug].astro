---
import ProjectCaseLayout from '../../layouts/ProjectCaseLayout.astro';
import { getPublishedProjects, type ProjectEntry } from '../../utils/projects';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();

  return projects.map((project, index) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      previous: projects[index - 1],
      next: projects[index + 1],
    },
  }));
}

interface Props {
  project: ProjectEntry;
  previous?: ProjectEntry;
  next?: ProjectEntry;
}

const { project, previous, next } = Astro.props;
---

<ProjectCaseLayout
  project={project}
  {...(previous ? { previous } : {})}
  {...(next ? { next } : {})}
/>
