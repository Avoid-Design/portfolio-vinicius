---
import type { ProjectEntry } from '../utils/projects';
import FeaturedProjectCard from './FeaturedProjectCard.astro';

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;
---

<section class="featured-projects" aria-labelledby="featured-title">
  <div class="subsection-heading">
    <p class="eyebrow">Seleção inicial</p>
    <h3 id="featured-title">Projetos em destaque</h3>
    <p>Três estruturas demonstrativas mostram como os cases reais serão organizados.</p>
  </div>
  <ul class="featured-project-list">
    {projects.map((project, index) => (
      <li><FeaturedProjectCard project={project} index={index} priority={index === 0} /></li>
    ))}
  </ul>
  <a class="text-link section-next-link" href="#biblioteca">Ver biblioteca completa</a>
</section>
