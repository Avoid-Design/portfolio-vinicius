---
import { brandAssets } from '../config/brand';
import { site } from '../config/site';
import BrandAsset from './BrandAsset.astro';
import BrandContext from './BrandContext.astro';
import ExperienceSection from './ExperienceSection.astro';
import ProfessionalFile from './ProfessionalFile.astro';
---

<section id="sobre" class="about-experience section-anchor" aria-labelledby="about-experience-title" data-home-block>
  <h2 id="about-experience-title" class="sr-only">Sobre e experiência</h2>

  <div class="professional-card">
    <div class="professional-card-top">
      <div class="profile-identity-column">
        <div class="professional-mark">
          <BrandAsset
            asset={brandAssets.support}
            class="professional-mark-image"
          />
        </div>
        <dl class="profile-facts">
          <div><dt>Local</dt><dd>{site.location}</dd></div>
          <div><dt>Formação</dt><dd>{site.education}</dd></div>
          <div><dt>Disponibilidade</dt><dd>{site.availability}</dd></div>
        </dl>
      </div>
      <ProfessionalFile />
    </div>

    <div class="professional-card-bottom">
      <ExperienceSection />
      <BrandContext />
    </div>
  </div>
</section>
