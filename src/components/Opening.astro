---
import { site } from '../config/site';
import { brandAssets } from '../config/brand';
import { homeAnchor } from '../utils/urls';
import BrandAsset from './BrandAsset.astro';
---

<section id="inicio" class="opening section-anchor" aria-labelledby="opening-title" data-home-block>
  <div class="opening-copy" data-opening-copy>
    <p class="eyebrow">{site.portfolioLabel} Técnico</p>
    <h1 id="opening-title">{site.name}</h1>
    <p class="opening-statement">{site.statement}</p>
    <div class="opening-actions">
      <a class="button-link" href={homeAnchor('projetos')}>Ver projetos</a>
      <a class="text-link" href={homeAnchor('contato')}>Contato</a>
    </div>
  </div>
  <figure class="cover-slot">
    <BrandAsset
      asset={brandAssets.cover}
      class="cover-asset"
    />
  </figure>
</section>
