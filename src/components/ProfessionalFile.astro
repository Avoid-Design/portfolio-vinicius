---
import { contacts, site } from '../config/site';
import ProgramList from './ProgramList.astro';
import SkillTags from './SkillTags.astro';
---

<section id="sobre" class="professional-file section-anchor" aria-labelledby="about-title">
  <div class="section-heading">
    <p class="eyebrow">Ficha profissional / 02</p>
    <h2 id="about-title">Sobre mim</h2>
  </div>

  <div class="professional-grid">
    <div class="profile-core">
      <p class="profile-name">{site.name}</p>
      <p class="profile-role">{site.role}</p>
      <p class="profile-summary">{site.summary}</p>
      <dl class="profile-facts">
        <div><dt>Local</dt><dd>{site.location}</dd></div>
        <div><dt>Formação</dt><dd>{site.education}</dd></div>
        <div><dt>Disponibilidade</dt><dd>{site.availability}</dd></div>
      </dl>
      <ul class="compact-contacts" aria-label="Canais profissionais">
        {contacts.map((contact) => (
          <li>
            <span>{contact.label}</span>
            {contact.status === 'configured' && contact.href ? (
              <a href={contact.href}>{contact.value}</a>
            ) : (
              <strong>{contact.value}</strong>
            )}
          </li>
        ))}
      </ul>
    </div>
    <div class="profile-capabilities">
      <ProgramList />
      <SkillTags />
    </div>
  </div>
</section>
