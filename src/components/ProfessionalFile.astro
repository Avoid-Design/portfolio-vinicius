---
import { site } from '../config/site';
import ProgramList from './ProgramList.astro';
import SkillTags from './SkillTags.astro';
---

<section class="professional-file" aria-labelledby="about-title">
  <h3 id="about-title" class="sr-only">Ficha profissional</h3>

  <div class="profile-core">
    <p class="profile-name">{site.name}</p>
    <p class="profile-role">{site.role}</p>
    <p class="profile-summary">{site.summary}</p>
  </div>

  <div class="profile-capabilities">
    <ProgramList />
    <SkillTags />
  </div>
</section>
