---
import { site } from '../config/site';
import ProgramList from './ProgramList.astro';
import SkillTags from './SkillTags.astro';
---

<section class="professional-file" aria-labelledby="about-title">
  <div class="subsection-heading">
    <p class="eyebrow">Ficha profissional</p>
    <h3 id="about-title">Sobre mim</h3>
  </div>

  <div class="professional-grid">
    <div class="profile-core">
      <p class="profile-name">{site.name}</p>
      <p class="profile-role">{site.role}</p>
      <p class="profile-summary">{site.summary}</p>
      <dl class="profile-facts">
        <div><dt>Local</dt><dd>{site.location}</dd></div>
        <div><dt>Formação</dt><dd>{site.education}</dd></div>
        <div><dt>Disponibilidade</dt><dd>{site.availability}</dd></div>
      </dl>
    </div>
    <div class="profile-capabilities">
      <ProgramList />
      <SkillTags />
    </div>
  </div>
</section>
