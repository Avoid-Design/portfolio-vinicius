---
import { experience } from '../data/experience';
---

<section class="experience" aria-labelledby="experience-title">
  <p class="panel-tab-label" aria-hidden="true">Experiência:</p>
  <h3 id="experience-title" class="sr-only">Experiência profissional</h3>
  <div class="experience-header">
    <div>
      <p class="experience-period">{experience.period}</p>
      <h4>{experience.company}</h4>
      <p>{experience.role}</p>
    </div>
    <p>{experience.summary}</p>
  </div>
  <div class="experience-areas">
    {experience.areas.map((area) => (
      <section class="experience-area">
        <h4>{area.title}</h4>
        <ul>
          {area.items.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    ))}
  </div>
</section>
