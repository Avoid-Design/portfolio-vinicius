---
import { experience } from '../data/experience';
---

<section id="experiencia" class="experience section-anchor" aria-labelledby="experience-title">
  <div class="section-heading">
    <p class="eyebrow">Experiência / 03</p>
    <h2 id="experience-title">Experiência profissional</h2>
  </div>
  <div class="experience-header">
    <div>
      <p class="experience-period">{experience.period}</p>
      <h3>{experience.company}</h3>
      <p>{experience.role}</p>
    </div>
    <p>{experience.summary}</p>
  </div>
  <div class="experience-areas">
    {experience.areas.map((area, index) => (
      <details open={index === 0}>
        <summary>{area.title}</summary>
        <ul>
          {area.items.map((item) => <li>{item}</li>)}
        </ul>
      </details>
    ))}
  </div>
</section>
