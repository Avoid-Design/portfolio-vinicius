---
import { experience } from '../data/experience';
---

<section class="experience" aria-labelledby="experience-title">
  <div class="subsection-heading">
    <p class="eyebrow">Histórico profissional</p>
    <h3 id="experience-title">Experiência profissional</h3>
  </div>
  <div class="experience-header">
    <div>
      <p class="experience-period">{experience.period}</p>
      <h4>{experience.company}</h4>
      <p>{experience.role}</p>
    </div>
    <p>{experience.summary}</p>
  </div>
  <div class="experience-areas">
    {experience.areas.map((area, index) => (
      <details open={index === 0}>
        <summary>{area.title}</summary>
        <ul>
          {area.items.map((item) => <li>{item}</li>)}
        </ul>
      </details>
    ))}
  </div>
</section>
